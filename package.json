    "verify:privacy": "node scripts/verify-privacy-manifest.mjs",
    "verify:applinks": "node scripts/verify-app-links.mjs",
    "verify:card-photo": "node scripts/verify-card-photo.mjs",
    "verify:capture-location": "node scripts/verify-capture-location.mjs",
    "verify:lead-search": "node scripts/verify-lead-search.mjs",

    "verify:voice": "node --env-file=.env scripts/verify-voice-note.mjs",
    "verify:messaging": "node scripts/verify-messaging.mjs",
    "verify:csv": "node scripts/verify-csv.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:export-live": "node --env-file=.env scripts/verify-export-live.mjs",
    "verify:summary": "node --env-file=.env scripts/verify-summary.mjs",

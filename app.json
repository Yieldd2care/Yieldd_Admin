{
  "expo": {
    "name": "Yieldd",
    "slug": "yieldd",
    "scheme": "yieldd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.yieldd.app",
      "associatedDomains": [
        "applinks:yieldd.co",
        "applinks:www.yieldd.co"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B132B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.yieldd.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "yieldd.co",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan business cards",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B132B"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Yieldd to access your photos so a saved dashboard image can be shown here.",
          "savePhotosPermission": "Allow Yieldd to save the dashboard image to your photos."
        }
      ],
      "expo-web-browser"
    ]
  }
}
